# LLM Configuration
# Copy this file to .env and adjust the values for your environment
LLM_DEFAULT=ollama|qwen3-coder-next:fullgpu|http://localhost:11434
LLM_FALLBACKS=groq|qwen/qwen3.6-27b|
LLM_FALLBACKS=openrouter|nvidia/nemotron-3-ultra-550b-a55b:free|
LLM_FALLBACKS=nvidia_nim|deepseek-ai/deepseek-v4-pro|https://integrate.api.nvidia.com/v1



LITELLM_ENABLED=true
LLM_GENERATION_TIMEOUT=120
LLM_HEALTHCHECK_TIMEOUT=8

OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen3-coder-next:fullgpu
REQUEST_TIMEOUT=120

CHAT_HISTORY_API_URL=http://127.0.0.1:8004
CHAT_HISTORY_WORKSPACE_ID=aone-local
CHAT_HISTORY_API_TOKEN=

TRELLO_CLONE_API_URL=http://127.0.0.1:8003
TRELLO_CLONE_API_KEY=

DEFAULT_EMBEDDING_PROVIDER=ollama
DEFAULT_EMBEDDING_MODEL=embeddinggemma
DEFAULT_EMBEDDING_API_BASE=http://localhost:11434
FALLBACK_EMBEDDING_PROVIDER=ollama
FALLBACK_EMBEDDING_MODEL=
FALLBACK_EMBEDDING_API_BASE=
EMBEDDING_TIMEOUT=10

# OpenRouter example:

AGENTMAIL_API_KEY=am_your_key_here
# GROQ_API_KEY=gsk-your-key-here

# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# NVIDIA_API_KEY=nvapi-your-key-here

# Dedicated heartbeat; never falls back to or shares a main LLM route.
HEARTBEAT_ENABLED=true
HEARTBEAT_INTERVAL_SECONDS=1800
HEARTBEAT_LLM_PROVIDER=ollama
HEARTBEAT_LLM_MODEL=qwen3.5:0.8b
# Defaults to OLLAMA_HOST; set a separate server here if needed.
# HEARTBEAT_LLM_API_BASE=http://127.0.0.1:11434
HEARTBEAT_TIMEOUT_SECONDS=120
